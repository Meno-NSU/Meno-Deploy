# Local environment — never commit the real values/secrets
.env

# OS / editor cruft
.DS_Store
*.swp

# Never commit an access-token file (the real one lives at /etc/nginx/.meno_htpasswd)
*.htpasswd
.meno_htpasswd

# Never commit the real benchmark token map (the real one lives at
# /etc/nginx/conf.d/meno-bench-token.conf and holds the token in clear text)
meno-bench-token.conf

# Never commit the real Grafana htpasswd (the real one lives at
# /etc/nginx/.meno_grafana_htpasswd)
.meno_grafana_htpasswd

.env.core
state/
backups/
__pycache__/
