{
  "uid": "meno-operational",
  "title": "Meno — операционные метрики",
  "tags": [
    "meno"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "type": "stat",
      "title": "Бэкенд жив",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "meno-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=\"meno-rag-api\"}",
          "legendFormat": "up",
          "datasource": {
            "type": "prometheus",
            "uid": "meno-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Пик запросов в полёте за период",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 4,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "meno-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max_over_time(meno_chat_in_flight[$__range])",
          "legendFormat": "пик",
          "datasource": {
            "type": "prometheus",
            "uid": "meno-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "description": "Мгновенное значение почти всегда 0 при редком трафике — скрейп раз в 15 с редко попадает внутрь запроса. Показан максимум за выбранный период."
    },
    {
      "type": "gauge",
      "title": "Пик насыщения admission за период",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 8,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "meno-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max_over_time((meno_admission_active / meno_admission_limit)[$__range:])",
          "legendFormat": "saturation",
          "datasource": {
            "type": "prometheus",
            "uid": "meno-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.8
              }
            ]
          }
        },
        "overrides": []
      },
      "description": "Максимум за период, по той же причине что и панель слева."
    },
    {
      "type": "stat",
      "title": "Запросов всего за период",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "meno-prometheus"
      },
      "description": "Счётчик, а не мгновенное значение: накапливается и не теряется между скрейпами. Если здесь 0, а Бэкенд жив = 1 — запросы действительно не доходят.",
      "fieldConfig": {
        "defaults": {
          "decimals": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(meno_chat_requests_total[$__range]))",
          "legendFormat": "запросов",
          "datasource": {
            "type": "prometheus",
            "uid": "meno-prometheus"
          }
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Запросов в секунду по провайдерам",
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 16,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "meno-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (provider) (rate(meno_chat_requests_total[5m]))",
          "legendFormat": "{{provider}}",
          "datasource": {
            "type": "prometheus",
            "uid": "meno-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Время ответа: среднее и процентили",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "meno-prometheus"
      },
      "targets": [
        {
          "refId": "D",
          "expr": "rate(meno_chat_request_seconds_sum[5m]) / rate(meno_chat_request_seconds_count[5m])",
          "legendFormat": "среднее (точное)",
          "datasource": {
            "type": "prometheus",
            "uid": "meno-prometheus"
          }
        },
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum by (le) (rate(meno_chat_request_seconds_bucket[5m])))",
          "legendFormat": "p50",
          "datasource": {
            "type": "prometheus",
            "uid": "meno-prometheus"
          }
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(meno_chat_request_seconds_bucket[5m])))",
          "legendFormat": "p95",
          "datasource": {
            "type": "prometheus",
            "uid": "meno-prometheus"
          }
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(meno_chat_request_seconds_bucket[5m])))",
          "legendFormat": "p99",
          "datasource": {
            "type": "prometheus",
            "uid": "meno-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "description": "Среднее считается из sum/count — точно, без интерполяции. Процентили считаются по корзинам гистограммы и интерполируются внутри корзины, поэтому на малом числе запросов p95/p99 завышаются и по сути показывают самый медленный ответ. Если среднее и p50 рядом, а p99 далеко вверху — это почти всегда один долгий ответ на малой выборке, а не деградация."
    },
    {
      "type": "timeseries",
      "title": "p95 по этапам пайплайна",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "meno-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, stage) (rate(meno_llm_latency_seconds_bucket[5m])))",
          "legendFormat": "{{stage}}",
          "datasource": {
            "type": "prometheus",
            "uid": "meno-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Ошибки по кодам",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 12
      },
      "datasource": {
        "type": "prometheus",
        "uid": "meno-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (code) (rate(meno_errors_total[5m]))",
          "legendFormat": "{{code}}",
          "datasource": {
            "type": "prometheus",
            "uid": "meno-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Прогоны бенчмарка (не смешиваются с продом)",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 12
      },
      "datasource": {
        "type": "prometheus",
        "uid": "meno-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (rate(meno_bench_requests_total[5m]))",
          "legendFormat": "{{status}}",
          "datasource": {
            "type": "prometheus",
            "uid": "meno-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "HTTP по роутам",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 20
      },
      "datasource": {
        "type": "prometheus",
        "uid": "meno-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (path, status) (rate(meno_http_requests_total[5m]))",
          "legendFormat": "{{path}} {{status}}",
          "datasource": {
            "type": "prometheus",
            "uid": "meno-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Свободно на дисках",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 20
      },
      "datasource": {
        "type": "prometheus",
        "uid": "meno-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "node_filesystem_avail_bytes{fstype!~\"tmpfs|overlay|squashfs|ramfs\"}",
          "legendFormat": "{{mountpoint}}",
          "datasource": {
            "type": "prometheus",
            "uid": "meno-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "CPU",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 28
      },
      "datasource": {
        "type": "prometheus",
        "uid": "meno-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "1 - avg(rate(node_cpu_seconds_total{mode=\"idle\"}[5m]))",
          "legendFormat": "занято",
          "datasource": {
            "type": "prometheus",
            "uid": "meno-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Доступно памяти",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 28
      },
      "datasource": {
        "type": "prometheus",
        "uid": "meno-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "node_memory_MemAvailable_bytes",
          "legendFormat": "available",
          "datasource": {
            "type": "prometheus",
            "uid": "meno-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      }
    }
  ]
}
