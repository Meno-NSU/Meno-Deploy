# Public domain served by nginx.
DOMAIN=meno.nsu.ru

# Email used for Let's Encrypt registration and expiry notices.
# Replace with a real address you control before deploying.
LETSENCRYPT_EMAIL=you@example.com

# Password for the read-only PostgreSQL role Grafana uses (monitoring stack).
# The role can read the usage_* views only — never messages.content.
# Generate with: openssl rand -base64 24
GRAFANA_DB_PASSWORD=
